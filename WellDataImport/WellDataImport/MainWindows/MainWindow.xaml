<Window x:Class="WellDataImport.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WellDataImport"
        mc:Ignorable="d"
        Title="Скважины" Height="450" Width="800" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">
    <Grid>
        <Border BorderBrush="Black" BorderThickness="1" HorizontalAlignment="Stretch" Height="160" Margin="10,5,10,5" VerticalAlignment="Top" RenderTransformOrigin="0.5,0">
            <Grid VerticalAlignment="Top" Margin="30,10,25,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="600" />
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="25"/>
                    <RowDefinition Height="70"/>
                    <RowDefinition Height="25"/>
                </Grid.RowDefinitions>
                <TextBox Grid.Column="0" Grid.Row="0" x:Name="tBFilePath" TextWrapping="Wrap" Text=""/>
                <Button Grid.Column="2" Grid.Row="0" x:Name="btnSelectFile" Content="Выбрать файл" Click="BtnSelectFile_Click" />
                <Button Grid.Column="2" Grid.Row="2" x:Name="btnDoImport" Content="Импортировать" Click="BtnDoImport_Click"/>
            </Grid>
        </Border>
        <Border BorderBrush="Black" BorderThickness="1" Margin="10,180,10,10" RenderTransformOrigin="0.5,0">
            <Grid VerticalAlignment="Top" Margin="30,10,30,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="610" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="25"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Button Grid.Column="1" Grid.Row="0" x:Name="btnViewDB" Content="Просмотр" Click="BtnViewDB_Click" />
                <DataGrid x:Name="dataGridView" Grid.ColumnSpan="2" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" AlternatingRowBackground="LightGray" GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Имя скважены" Binding="{Binding Path=Name}" Width="*" />
                        <DataGridTextColumn Header="ОТ" Binding="{Binding Path=From}" Width="80" />
                        <DataGridTextColumn Header="ДО" Binding="{Binding Path=To}" Width="80" />
                        <DataGridTextColumn Header="Au" Binding="{Binding Path=Au}" Width="80" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</Window>
