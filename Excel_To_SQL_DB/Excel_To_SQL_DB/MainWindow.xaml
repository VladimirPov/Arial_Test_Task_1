<Window x:Class="Excel_To_SQL_DB.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Excel_To_SQL_DB"
        mc:Ignorable="d"
        Title="Скважены" Height="450" Width="800" ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <Grid>
        <Border BorderBrush="Black" BorderThickness="1" HorizontalAlignment="Stretch" Height="200" Margin="10,5,10,5" VerticalAlignment="Top" RenderTransformOrigin="0.5,0">
            <Grid VerticalAlignment="Top" Margin="30,10,30,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="600" />
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="25"/>
                    <RowDefinition Height="70"/>
                    <RowDefinition Height="25"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Column="0" Grid.Row="0" x:Name="textBlock" TextWrapping="Wrap" Text="" />
                <Button Grid.Column="2" Grid.Row="0" x:Name="button" Content="Выбрать файл" />
                <Button Grid.Column="2" Grid.Row="2" x:Name="button2" Content="Импортировать"/>
            </Grid>
        </Border>
        <Border BorderBrush="Black" BorderThickness="1" Margin="10,224,10,10" RenderTransformOrigin="0.5,0"/>
    </Grid>
</Window>
